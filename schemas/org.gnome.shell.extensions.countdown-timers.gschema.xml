<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.countdown-timers"
          path="/org/gnome/shell/extensions/countdown-timers/">

    <!--
      Active timers — stored as a JSON array.
      Each entry:
      {
        "id":        "abc123",
        "label":     "Coffee",       // optional
        "endEpoch":  1700000000,     // Unix timestamp when it expires
        "paused":    false,
        "remaining": 300,            // seconds left when paused
        "finished":  false
      }
    -->
    <key name="timers-json" type="s">
      <default>""</default>
      <summary>Serialised active timer state</summary>
      <description>JSON array of all active countdown timers.</description>
    </key>

    <!--
      Saved timer presets — stored as a JSON array.
      Each entry:
      {
        "id":    "xyz789",
        "label": "Pomodoro",         // required for saved timers
        "input": "0:25:00"           // the raw input string the user originally typed
      }
      Clicking a preset creates a new active timer from its input string.
    -->
    <key name="saved-timers-json" type="s">
      <default>""</default>
      <summary>Saved timer presets</summary>
      <description>JSON array of named timer presets the user can launch with one click.</description>
    </key>

    <!--
      Absolute path to a custom alarm sound file.
      Empty string means "use the system default".
    -->
    <key name="alarm-sound-path" type="s">
      <default>""</default>
      <summary>Custom alarm sound file path</summary>
      <description>Absolute path to an audio file played when a timer expires.</description>
    </key>

    <!--
      When true, every running timer is shown as a separate label in the panel.
      When false (default), only the nearest timer is shown.
    -->
    <key name="show-all-in-panel" type="b">
      <default>false</default>
      <summary>Show all countdowns in the panel</summary>
      <description>Display every active countdown simultaneously in the top bar.</description>
    </key>

  </schema>
</schemalist>
